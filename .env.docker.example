# Copiar a .env antes de `docker compose up`. Los valores de abajo son los
# de desarrollo local; para cualquier despliegue real hay que rotarlos.

# --- Base de datos ---
POSTGRES_USER=ayuda
POSTGRES_PASSWORD=ayuda-local
POSTGRES_DB=ayuda_terremoto
POSTGRES_PORT=5433

# --- Nodo Central ---
# En "production" la app se niega a arrancar con los secretos de ejemplo,
# o con un JWT_SECRET de menos de 32 bytes. Generá uno con:
#   openssl rand -hex 32
ENVIRONMENT=development
JWT_SECRET=cambia-esto-en-produccion
NODOS_SECRETO_INICIAL=cambia-esto-en-produccion

# Opcionales: sin ellos la app corre igual (IA por plantilla, WhatsApp en
# sandbox, Ushahidi con datos de ejemplo).
GROQ_API_KEY=
USHAHIDI_BASE_URL=

# WhatsApp: para conectar tu propio número, ver
# sistema-ayuda-nacional/docs/whatsapp-meta.md. Vacías = modo sandbox.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Nodo Local ---
# URL a la que llama el navegador, no el contenedor.
VITE_API_BASE_URL=http://localhost:8000

# --- GeoServer (solo con --profile geo) ---
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver-local
