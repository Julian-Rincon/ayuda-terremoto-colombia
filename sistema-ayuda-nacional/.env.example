# Poné esto en "production" al desplegar de verdad. Con production activo,
# la app se NIEGA A ARRANCAR si JWT_SECRET o NODOS_SECRETO_INICIAL siguen
# con el valor de ejemplo de abajo — así no se puede desplegar por
# accidente sin rotarlos primero.
ENVIRONMENT=development

# Opcional. Sin esto, clasificación de reportes por reglas y resúmenes
# (alerta sísmica, resumen para el coordinador) por plantilla — gratis,
# sin red, nunca falla.
GROQ_API_KEY=

# Opcional. Por defecto SQLite local (bueno para desarrollo, no para
# producción: en Render free tier el disco es efímero y se reinicia cada
# vez que el proceso duerme por inactividad y despierta — los datos
# sembrados desaparecen). Para apuntar a Postgres, usar una URL con
# esquema postgresql://, ej.:
# DATABASE_URL=postgresql://usuario:clave@host:5432/nombre_bd
# En producción (Render) esta variable la resuelve el blueprint
# (render.yaml, bloque `databases:`) automáticamente vía `fromDatabase`.
DATABASE_URL=sqlite:///./sistema_ayuda_nacional.db

# --- WhatsApp Business Cloud API (opcional) ---
# Para conectar TU propio número. Guía paso a paso:
# docs/whatsapp-meta.md. Sin ninguna de estas, el canal corre en modo
# sandbox y se prueba con POST /sandbox/whatsapp/simular.
#
# 1) Cadena larga al azar que vos elegís. La misma va en el panel de Meta.
#    Sin esto, Meta no puede verificar la URL del webhook y el número no se
#    puede conectar. Generá una con: openssl rand -hex 32
WHATSAPP_VERIFY_TOKEN=
#
# 2) "App Secret" de tu app en developers.facebook.com. Hace que el webhook
#    exija la firma X-Hub-Signature-256 — sin esto acepta cualquier payload.
WHATSAPP_APP_SECRET=
#
# 3) Opcionales: solo si querés que el sistema conteste un acuse de recibo a
#    quien escribe. Sin estas dos, el canal solo escucha.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# URL base de una instancia Ushahidi real, ej. https://mi-instancia.ushahidi.io
# Sin esto, la sincronización usa datos de ejemplo (fixture).
USHAHIDI_BASE_URL=

# Firma usada para emitir/validar JWT de nodos locales. CAMBIAR antes de
# cualquier despliegue real, y que tenga al menos 32 bytes: con
# ENVIRONMENT=production la app se niega a arrancar si es más corta
# (RFC 7518 §3.2 — una clave corta se rompe por fuerza bruta aunque la
# hayas cambiado). Generá una con:
#   openssl rand -hex 32
JWT_SECRET=cambia-esto-en-produccion

# Secreto inicial compartido para los CentroLocal sembrados. CAMBIAR antes
# de cualquier despliegue real (o rotar credenciales por nodo).
NODOS_SECRETO_INICIAL=cambia-esto-en-produccion
