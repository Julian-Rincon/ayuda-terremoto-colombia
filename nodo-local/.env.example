# URL del Nodo Central (sistema-ayuda-nacional). Por defecto localhost:8000.
VITE_API_BASE_URL=http://localhost:8000

# Opcional — capas WMS de GeoServer sobre PostGIS. Sin esto el mapa usa solo
# OpenStreetMap y los datos de la API (ver sistema-ayuda-nacional/docs/
# geoserver-postgis.md). Con `docker compose --profile geo`:
# VITE_WMS_URL=http://localhost:8080/geoserver/ayuda/wms
VITE_WMS_URL=
# Capas a ofrecer, como "espacio:capa:Etiqueta visible" separadas por coma.
VITE_WMS_CAPAS=ayuda:capa_centros:Centros (WMS),ayuda:capa_eventos_sismicos:Sismos 30 días
